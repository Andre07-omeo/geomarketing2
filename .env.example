# ============================================
# FIREBASE CONFIGURATION - TEMPLATE
# ============================================
# Récupère ces valeurs depuis Firebase Console
# Firebase > Paramètres du projet > Applications > Config

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
NEXT_PUBLIC_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloudinary_id/image/upload
NEXT_PUBLIC_UPLOAD_PRESET=your_upload_preset

# ============================================
# LOGO & IMAGES
# ============================================
NEXT_PUBLIC_LOGO_URL=/icon-512x512.png

# ============================================
# APPLICATION CONFIG
# ============================================
NEXT_PUBLIC_APP_NAME=Geomarketing
NEXT_PUBLIC_APP_VERSION=2.0.0
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000